# Production Environment Configuration — EXAMPLE ONLY
# Copy to backend/.env.production and fill real values. Do NOT commit secrets.
# Domain: https://api.autopilot.monster

# Application
APP_PORT=8000
APP_HOST=0.0.0.0
APP_URL=https://api.autopilot.monster
NODE_ENV=production
APP_SECRET=change-me-app-secret
LOG_LEVEL=info
LOG_FORMAT=json

# Database (PostgreSQL)
# Prefer migrations over synchronize in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
DB_SYNCHRONIZE=false
DB_SSL=true
DB_LOGGING=false
DB_POOL_SIZE=20

# Cache / Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_TLS=false
REDIS_TTL=3600

# Storage (S3-compatible)
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=443
MINIO_ACCESS_KEY=change-me-access-key
MINIO_SECRET_KEY=change-me-secret-key

# Vector Database
QDRANT_URL=http://qdrant:6333

# Authentication (RS256 required in production)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=
FRONTEND_URL=https://autopilots.monster/demo

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Alternative payment providers (not implemented)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# OAuth (fill only providers you enable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.autopilot.monster/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.autopilot.monster/api/v1/auth/facebook/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.autopilot.monster/api/v1/auth/github/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=https://api.autopilot.monster/api/v1/auth/apple/callback
