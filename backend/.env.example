# Application Configuration
APP_PORT=8000
APP_HOST=0.0.0.0
APP_URL=http://localhost:8000
NODE_ENV=development
APP_SECRET=your-secret-app-key
LOG_LEVEL=debug
LOG_FORMAT=json

# Database Configuration
# Prefer discrete DB_* vars. If DATABASE_URL is set it wins over DB_HOST/DB_NAME/etc.
# Local docker-compose.yml defaults: host=postgres, user=root, password=password, db=autopilot_monster
# DATABASE_URL=postgresql://root:password@postgres:5432/autopilot_monster
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autopilot_monster
DB_USER=root
DB_PASSWORD=password
DB_SYNCHRONIZE=false
DB_SSL=false
DB_LOGGING=true
DB_POOL_SIZE=10

# Redis Configuration (compose: redis / password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_DB=0
REDIS_TLS=false
REDIS_TTL=3600

# Object Storage (MinIO or S3) — compose: minio:9000 / minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=autopilot-assets
MINIO_BUCKET_BACKUPS=autopilot-backups

# Vector Database (Qdrant) — compose: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Autopilot Monster <noreply@autopilots.monster>"

# Authentication (JWT)
# HS256 (dev): set JWT_SECRET
# RS256 (production required): set JWT_ALGORITHM=RS256, JWT_PRIVATE_KEY, JWT_PUBLIC_KEY
JWT_ALGORITHM=HS256
JWT_SECRET=your_jwt_secret
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# AI Services
OPENAI_API_KEY=your_openai_api_key
FRONTEND_URL=http://localhost:3000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard; required for paid plan checkout)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=

# Alternative payment providers (not implemented — stubs return 503 until wired)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:8000/api/v1/auth/facebook/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Apple OAuth
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
APPLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/apple/callback

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=my_secure_token_123
DEFAULT_TENANT_ID=
WHATSAPP_SLA_MS=900000
